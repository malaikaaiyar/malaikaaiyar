---
import type { Post } from '../lib/posts';
import { tagsConfig } from '../config/tags';
const { post, no, showYear = false } = Astro.props as { post: Post; no?: number; showYear?: boolean };
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const [d, m, y] = post.date.split('.');
const date = `${Number(d)} ${months[Number(m) - 1]}${showYear ? ' ' + y : ''}`;
const kind = post.external ? 'essay, Substack ↗' : post.tags.map(t => tagsConfig[t]?.long ?? t).join(', ');
---
<a class="row" href={post.href} {...(post.external ? { target: '_blank', rel: 'noopener' } : {})}>
  {no !== undefined && <span class="row-no">No. {String(no).padStart(3, '0')}</span>}
  <span class="row-t">{post.title}</span>
  <span class="row-k">{kind}</span>
  <span class="row-d">{date}</span>
</a>
