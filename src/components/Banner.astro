---
import { banner, rowHtml } from '../lib/weave';
const rows = banner(['MALAIKA', 'AIYAR'], 'malaika aiyar');
---
<h1 class="banner" aria-label="Malaika Aiyar"><pre id="weave" aria-hidden="true" title="click to re-weave">{rows.map(r => <span class="r" data-c={r.c} set:html={rowHtml(r.text)} />)}</pre></h1>

<script>
  import { rowHtml } from '../lib/weave';
  const pre = document.getElementById('weave');
  if (pre) {
    const rows = [...pre.querySelectorAll<HTMLElement>('.r')];
    const model = rows.map(r => (r.textContent ?? '').split(''));
    const flip = (i: number, n: number) => {
      const m = model[i], c = rows[i].dataset.c ?? '+';
      for (let k = 0; k < n; k++) {
        const j = Math.floor(Math.random() * m.length);
        if (m[j] !== '0') m[j] = m[j] === ' ' && Math.random() < 0.16 ? c : ' ';
      }
      rows[i].innerHTML = rowHtml(m.join(''));
    };
    pre.addEventListener('click', () => rows.forEach((_, i) => flip(i, 80)));
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(() => flip(Math.floor(Math.random() * rows.length), 3), 160);
    }
  }
</script>
