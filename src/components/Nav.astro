<div class="right">
    <div class="tags-container">
        <div class="tags-stack">
            {orderedTags.map(([tag, count], index) => {
                const tagInfo = tagsConfig[tag as keyof typeof tagsConfig];
                return (
                    <div class="tag-stack-item">
                        <a href={`/tags/${tag}`} class="tag-stack-link">
                            <span class="tag-stack-name">{tagInfo?.long || tag.toUpperCase()}</span>
                            <span class="tag-stack-description">{tagInfo?.description}</span>
                        </a>
                        {index < orderedTags.length - 1 && <div class="tag-separator"></div>}
                    </div>
                );
            })}
        </div>
