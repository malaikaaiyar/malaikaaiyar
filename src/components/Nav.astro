---
// Import tags configuration from shared config
import { tagsConfig } from '../config/tags';

// Get all posts to analyze tags
const posts = import.meta.glob('../components/posts/*.astro');
// random

const postModules = await Promise.all(
  Object.entries(posts).map(async ([path, resolver]) => {
    const mod = await resolver() as any;
    const slug = path
      .split('/')
      .pop()
      ?.replace('.astro', '')
      ?.toLowerCase() || '';
    return {
      ...mod,
      slug,
    };
  })
);

// Count posts by tag
const tagCounts: { [key: string]: number } = {};
postModules.forEach((post: any) => {
  if (post.tags) {
    post.tags.forEach((tag: string) => {
      tagCounts[tag] = (tagCounts[tag] || 0) + 1;
    });
  }
});

// Build ordered tags based on config order, including only tags with posts
const orderedTags: [string, number][] = Object.keys(tagsConfig)
  .filter((tag) => tagCounts[tag] > 0)
  .map((tag) => [tag, tagCounts[tag]] as [string, number]);
