---
// Friends' sites live on single characters of the computer.
// To add one: pick a row (0-based) and column of a visible character.
const art = [
  '                 .----.',
  '     .---------. | == |',
  '     |.-"""""-.| |----|',
  '     ||       || | == |',
  '     ||       || |----|',
  "     |'-.....-'| |::::|",
  "     `\"\")---(\"\"' |___.|",
  '     /:::::::::::\\" _  "',
  '   /:::=======:::\\`\\`\\',
  "    `\"\"\"\"\"\"\"\"\"\"\"\"\"` '-'",
];

const friends = [
  { row: 1, col: 19, href: 'https://fayewrites.substack.com/' },
  { row: 2, col: 9, href: 'https://marsh.blue' },
  { row: 3, col: 20, href: 'https://jasminexli.com/' },
  { row: 4, col: 14, href: 'https://nevedhaa.com/' },
  { row: 5, col: 10, href: 'https://helenatran.com/' },
  { row: 5, col: 19, href: 'https://ericyrhuang.com/' },
  { row: 6, col: 5, href: 'https://lydia.ml' },
  { row: 7, col: 11, href: 'https://www.sunkht.xyz' },
  { row: 8, col: 9, href: 'https://agniv.me' },
  { row: 8, col: 19, href: 'https://jason.ml' },
  { row: 9, col: 12, href: 'https://mkodama.org/' },
];

const rows = art.map((line, y) => {
  const parts: { text: string; href?: string }[] = [];
  let last = 0;
  friends.filter(f => f.row === y).sort((a, b) => a.col - b.col).forEach(f => {
    if (line[f.col] === ' ' || line[f.col] === undefined) throw new Error(`friend link at ${y},${f.col} is not on a character`);
    parts.push({ text: line.slice(last, f.col) }, { text: line[f.col], href: f.href });
    last = f.col + 1;
  });
  parts.push({ text: line.slice(last) + '\n' });
  return parts;
});
---
<div class="ascii-art"><pre>{rows.map(parts => parts.map(p => p.href ? <a class="ascii-link" href={p.href} target="_blank" rel="noopener">{p.text}</a> : p.text))}</pre></div>
