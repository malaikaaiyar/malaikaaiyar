---
export interface Props {
  title: string;
  date: string;
  description: string;
  slug: string;
  color?: string;
}

const { title, date, description, slug, color } = Astro.props;
---
<!-- style={color ? `--tile-bg: ${color}` : ''} -->
<li class="post-list-item tile">
  <a class="tile-link" href={`/posts/${slug}`}>
    <div class="tile-title">{title}</div>
    <div class="tile-date">{date}</div>
  </a>
</li> 

