---
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/400-italic.css';
import '@fontsource/courier-prime/700.css';
import { SUBSTACK } from '../lib/posts';
import '../styles.css';

const container = Astro.props.container ?? true;
const index = Astro.props.index ?? false;
const title = Astro.props.title ?? 'Malaika Aiyar';
const description = Astro.props.description ?? 'Malaika Aiyar — software engineer in San Francisco working on agents and security. Printmaking, pottery, notes.';
const pageTitle = title === 'Malaika Aiyar' ? title : `${title} | Malaika Aiyar`;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Info' },
  { href: '/idx', label: 'Index' },
  { href: '/now', label: 'Now' },
  { href: '/posts/gallery', label: 'Gallery' },
];
const active = (href: string) =>
  href === '/' ? path === '/' : path === href || (href === '/idx' && (path.startsWith('/tags/') || (path.startsWith('/posts/') && path !== '/posts/gallery')));
const kind = index ? 'home' : container ? 'page' : 'wide';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="alternate" type="application/rss+xml" title="Malaika Aiyar on Substack" href={`${SUBSTACK}/feed`} />
		<link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)">
		<link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)">
		<script is:inline>
			(function () {
				var t = 'light';
				try { t = localStorage.getItem('theme') || 'light'; } catch (e) {}
				document.documentElement.setAttribute('data-theme', t);
			})();
		</script>
	</head>
	<body>
		<div class="sheet">
			<header class="head">
				<a class="name" href="/">Malaika Aiyar</a>
				<nav aria-label="Primary">
					{links.map((l, i) => (
						<><a href={l.href} class:list={[{ active: active(l.href) }]} aria-current={active(l.href) ? 'page' : undefined}>{l.label}</a>{i < links.length - 1 && <span aria-hidden="true">, </span>}</>
					))}
				</nav>
			</header>

			<main class={kind}>
				{kind === 'page' ? <div class="post-container"><slot /></div> : <slot />}
			</main>

			<footer class="foot">
				<p>
					<span class="caps">Contact:</span>
					<a href="mailto:malaika.aiyar@gmail.com">malaika.aiyar@gmail.com</a>,
					<a href={SUBSTACK}>Substack</a>,
					<a href="https://github.com/malaikaaiyar">GitHub</a>,
					<a href="https://www.linkedin.com/in/malaika-aiyar/">LinkedIn</a>
				</p>
				<p>
					<span id="current-time">--:--:--</span> <span class="caps">San Francisco</span>
					<button id="theme-toggle" type="button">(Lights off)</button>
				</p>
			</footer>
		</div>

		<script is:inline>
			(function () {
				var html = document.documentElement, btn = document.getElementById('theme-toggle');
				function label() { btn.textContent = html.getAttribute('data-theme') === 'dark' ? '(Lights on)' : '(Lights off)'; }
				btn.addEventListener('click', function () {
					var next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
					html.setAttribute('data-theme', next);
					try { localStorage.setItem('theme', next); } catch (e) {}
					label();
				});
				label();
				var clock = document.getElementById('current-time');
				function tick() {
					clock.textContent = new Date().toLocaleTimeString('en-GB', { hour12: false, timeZone: 'America/Los_Angeles' });
				}
				tick(); setInterval(tick, 1000);
			})();
		</script>
	</body>
</html>
