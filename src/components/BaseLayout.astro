---
import Nav from '../components/Nav.astro';
import '../styles.css';

const container = Astro.props.container ?? true;
const index = Astro.props.index ?? false;
const title = Astro.props.title ?? 'Malaika Aiyar';
const pageTitle = title === 'Malaika Aiyar' ? title : `${title} | Malaika Aiyar`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{pageTitle}</title>
		<!-- No webfonts: the type stack is system monospace (see --font-mono) -->

		<!-- Favicons: dot matching the custom cursor -->
		<link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)">
		<link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)">
		
		<script>
			// Apply theme immediately to prevent flash
			(function() {
				const theme = localStorage.getItem('theme') || 'light';
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
		<script>
			// Move Curius container into .left section to prevent viewport overflow
			// This constrains it to the viewport while allowing Curius elements to position correctly
			(function() {
				function moveCuriusContainer() {
					const curiusContainer = document.getElementById('curius-container');
					const leftSection = document.querySelector('.left');
					
					if (curiusContainer && leftSection) {
						// Only move if it's not already in the right place
						if (curiusContainer.parentElement !== leftSection) {
							// Move to .left section (which is constrained to 100vh)
							leftSection.appendChild(curiusContainer);
							console.log('✅ Moved Curius container into .left section');
						}
					}
				}
				
				// Try immediately in case Curius is already loaded
				moveCuriusContainer();
				
				// Watch for Curius container being added to DOM
				const observer = new MutationObserver(function(mutations) {
					mutations.forEach(function(mutation) {
						mutation.addedNodes.forEach(function(node) {
							if (node.nodeType === 1 && node instanceof Element) { // Element node
								// Check if the added node is the curius container
								if (node.id === 'curius-container') {
									moveCuriusContainer();
								}
								// Or check if it contains the curius container
								const curiusContainer = node.querySelector('#curius-container');
								if (curiusContainer) {
									moveCuriusContainer();
								}
							}
						});
					});
				});
				
				// Start observing
				observer.observe(document.body, {
					childList: true,
					subtree: true
				});
				
				// Also check periodically as a fallback
				setInterval(moveCuriusContainer, 1000);
			})();
		</script>
	</head>
	<body>
		<Nav>
			{index && (
				<slot />
			)}
			{!index && (
			<div class="container">
				{container && (
					<div class="post-container">
						<slot />
					</div>
				)}
				{!container && <slot />}
			</div>
			)}
		</Nav>

		
	</body>
</html>