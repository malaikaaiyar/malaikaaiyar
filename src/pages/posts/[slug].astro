---
import BaseLayout from '../../components/BaseLayout.astro';

// 1. Define getStaticPaths to generate all possible slugs
export async function getStaticPaths() {
  const postImporters = import.meta.glob('../../components/posts/*.astro');
  const paths = Object.keys(postImporters).map((path) => {
    const slug = path.split('/').pop()?.replace('.astro', '')?.toLowerCase() || '';
    return { params: { slug } };
  });
  return paths;
}

// 2. Get the slug from params
const { slug } = Astro.params;

// 3. Find and load the correct post
const postImporters = import.meta.glob('../../components/posts/*.astro');
let PostComponent = null;
let container = true; // default
let postTags: string[] = [];

for (const [path, resolver] of Object.entries(postImporters)) {
  const fileSlug = path.split('/').pop()?.replace('.astro', '')?.toLowerCase() || '';
  if (fileSlug === slug) {
    const mod = await resolver() as any;
    PostComponent = mod.default;
     // Check for exported 'container'
     if ('container' in mod) {
      container = mod.container;
    }
    // Get tags if they exist
    if ('tags' in mod) {
      postTags = mod.tags;
    }
    break;
  }
}

if (!PostComponent) {
  throw new Error('Post not found');
}
---
<BaseLayout container={container}>
  <PostComponent />
</BaseLayout>
